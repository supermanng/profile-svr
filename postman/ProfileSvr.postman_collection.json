                  "  pm.collectionVariables.set('retrievalCode', d.retrievalCode);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "otp/verify \u00b7 section Kyc (\u2192 tier 1)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/otp/verify",
            "header": [
              {
                "key": "Content-Type",
