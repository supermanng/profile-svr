            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"{{deviceId}}\",\n  \"retrievalCode\": \"{{retrievalCode}}\",\n  \"otp\": \"{{otp}}\",\n  \"section\": \"Kyc\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('KYC verified, tier 1', () => {",
                  "  const d = pm.response.json().data;",
                  "  pm.expect(d.tier).to.eql(1);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3 \u00b7 Session",
      "item": [
