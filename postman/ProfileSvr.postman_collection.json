    {
      "name": "8 \u00b7 Profile queries",
      "item": [
        {
          "name": "GET profile by id",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": "{{baseUrl}}/api/profiles/{{profileId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('profile with gates', () => {",
                  "  const d = pm.response.json().data;",
                  "  console.log('status:', d.status, '| tier:', d.tier, '| recentlyLinked:', d.deviceRecentlyLinked);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET my devices (history)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/profiles/devices"
          }
        },
        {
          "name": "GET my activities",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/profiles/activities?page=1&pageSize=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "profiles",
                "activities"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "20"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('audit feed', () => {",
                  "  const items = pm.response.json().data.items;",
                  "  items.forEach(i => console.log(i.createdAtUtc, i.type, '\u00b7', i.description, '\u00b7 ip:', i.ipAddress));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET list profiles",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": "{{baseUrl}}/api/profiles?page=1&pageSize=20"
          }
        },
        {
          "name": "GET device by id",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": "{{baseUrl}}/api/devices/{{deviceId}}"
          }
        }
      ]
    }
  ]
}