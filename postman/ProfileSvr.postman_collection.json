{
  "info": {
    "name": "ProfileSvr",
    "description": "End-to-end tests for the ProfileSvr microservice.\n\n**How to use**\n1. Set `baseUrl`, `email`, `password` in the collection variables.\n2. Run requests top-to-bottom inside each folder. Scripts auto-save `deviceId`, `retrievalCode`, `profileId`, `accessToken` between steps.\n3. Whenever a step sends an OTP (by email or WhatsApp), read the 6-digit code and paste it into the `otp` collection variable before the next request.\n\nEvery response is the `{isSuccess, data, message}` envelope \u2014 `message` is always populated (specific per step, e.g. \"OTP sent to your email address.\", or \"Operation successful.\").\n\nAssumes `Encryption:Enabled` is false; with payload encryption on, bodies must be wrapped in the `{\"data\": ...}` envelope.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5107"
    },
    {
      "key": "email",
      "value": "testuser1@maildrop.cc"
    },
    {
      "key": "password",
      "value": "Test-Pass-2026!"
    },
    {
      "key": "otp",
      "value": "000000"
    },
    {
      "key": "phone",
      "value": "+2348012345678"
    },
    {
      "key": "bvn",
      "value": "22233344455"
    },
    {
      "key": "pin",
      "value": "1234"
    },
    {
      "key": "newPin",
      "value": "5678"
    },
    {
      "key": "deviceIdentifier",
      "value": "postman-device-1"
    },
    {
      "key": "deviceId",
      "value": ""
    },
    {
      "key": "retrievalCode",
      "value": ""
    },
    {
      "key": "profileId",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0 \u00b7 Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('healthy envelope with message', () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.isSuccess).to.be.true;",
                  "  pm.expect(b.data.status).to.eql('healthy');",
                  "  pm.expect(b.message).to.eql('Operation successful.');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1 \u00b7 Onboarding",
      "item": [
        {
          "name": "1. initiate (email OTP sent)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "url": "{{baseUrl}}/api/onboarding/initiate",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"emailAddress\": \"{{email}}\",\n  \"device\": {\n    \"deviceIdentifier\": \"{{deviceIdentifier}}\",\n    \"name\": \"Postman Device\",\n    \"platform\": \"web\",\n    \"osName\": \"macOS\",\n    \"osVersion\": \"14\",\n    \"manufacturer\": \"Apple\",\n    \"model\": \"MacBook\",\n    \"appVersion\": \"1.0.0\"\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('202 + retrievalCode + message', () => {",
                  "  pm.expect(pm.response.code).to.eql(202);",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.message).to.eql('OTP sent to your email address.');",
                  "  pm.collectionVariables.set('deviceId', b.data.deviceId);",
                  "  pm.collectionVariables.set('retrievalCode', b.data.retrievalCode);",
                  "});",
                  "console.log('>> Now read the email OTP and set the `otp` variable.');"
                ]
              }
            }
          ]
        },
        {
          "name": "2. verify-auth (paste otp first)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "url": "{{baseUrl}}/api/onboarding/verify-auth",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"emailAddress\": \"{{email}}\",\n  \"deviceId\": \"{{deviceId}}\",\n  \"retrievalCode\": \"{{retrievalCode}}\",\n  \"otp\": \"{{otp}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 \u00b7 auth created + onboarding tokens', () => {",
                  "  pm.expect(pm.response.code).to.eql(201);",
                  "  const d = pm.response.json().data;",
                  "  pm.expect(d.status).to.eql('AuthCreated');",
                  "  pm.expect(d.type).to.eql('onboarding');",
                  "  pm.collectionVariables.set('profileId', d.profileId);",
                  "  if (d.tokens) {",
                  "    pm.collectionVariables.set('accessToken', d.tokens.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', d.tokens.refreshToken);",
                  "    console.log('>> Onboarding tokens saved \u2014 steps 4-6 work without the login step.');",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3. login",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"deviceId\": \"{{deviceId}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('tokens + profile DTO + deviceStatus', () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.message).to.eql('Login successful.');",
                  "  const d = b.data;",
                  "  pm.expect(d.accessToken).to.be.a('string');",
                  "  pm.expect(['New', 'Existing', 'Unlinked']).to.include(d.deviceStatus);",
                  "  pm.collectionVariables.set('accessToken', d.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', d.refreshToken);",
                  "  if (d.profile) {",
                  "    pm.collectionVariables.set('profileId', d.profile.profileId);",
                  "    pm.collectionVariables.set('deviceId', d.profile.activeDeviceId);",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "4. initiate-phone (WhatsApp OTP sent)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/onboarding/initiate-phone",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"{{phone}}\",\n  \"deviceId\": \"{{deviceId}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('202 + retrievalCode', () => {",
                  "  pm.expect(pm.response.code).to.eql(202);",
                  "  pm.collectionVariables.set('retrievalCode', pm.response.json().data.retrievalCode);",
                  "});",
                  "console.log('>> Read the WhatsApp OTP and set the `otp` variable.');"
                ]
              }
            }
          ]
        },
        {
          "name": "5. otp/verify \u00b7 section Phone",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/otp/verify",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"{{deviceId}}\",\n  \"retrievalCode\": \"{{retrievalCode}}\",\n  \"otp\": \"{{otp}}\",\n  \"section\": \"Phone\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('phone confirmed', () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.message).to.eql('Phone number verified.');",
                  "  pm.expect(b.data.phoneNumberConfirmed).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "6. create-profile (\u2192 Active)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/onboarding/create-profile",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"{{deviceId}}\",\n  \"firstName\": \"Test\",\n  \"lastName\": \"User\",\n  \"middleName\": null,\n  \"dateOfBirth\": \"1995-05-15\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status Active', () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.message).to.eql('Profile created successfully.');",
                  "  pm.expect(b.data.status).to.eql('Active');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2 \u00b7 KYC path (alternative to steps 4-6)",
      "item": [
        {
          "name": "initiate-kyc (BVN \u2192 WhatsApp OTP)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/onboarding/initiate-kyc",
